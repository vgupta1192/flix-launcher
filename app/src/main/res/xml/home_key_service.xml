<?xml version="1.0" encoding="utf-8"?>
<!-- No packageNames filter: window-state events from every app tell the service which one is in front.
     Window content access is only used once, on connect, to see whether the stock home is showing.
     No key-event filtering: with flagRequestFilterKeyEvents the service intercepts every key on the
     TV, which silently disabled Android's key repeat — holding the volume button changed the volume
     once instead of continuously in every app. The Home button is caught by watching for the stock
     home screen instead. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:canRetrieveWindowContent="true"
    android:description="@string/home_key_service_description"
    android:notificationTimeout="0" />
